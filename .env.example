# ---- App ----
NODE_ENV=development
PORT=3000

# ---- PostgreSQL ----
# When running the API inside docker-compose, host is the service name "postgres".
# When running the API on your host machine (npm run start:dev), use "localhost".
DB_HOST=localhost
DB_PORT=5432
DB_USER=merchant
DB_PASSWORD=merchant_pw
DB_NAME=merchant_onboarding

# ---- Redis / BullMQ ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- Auth ----
# Generate a strong value for real use, e.g. `openssl rand -base64 48`.
# This is a NON-SECRET placeholder for local/dev only.
JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=1h

# ---- Seed users (created by the seed script; dev only) ----
SEED_DEFAULT_PASSWORD=Password123!
